{
  "name": "queueflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A campus virtual queue with a student portal, staff desk and isolated practice workspaces",
  "engines": {
    "node": ">=24.20.0 <25.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "staff:add": "node --env-file-if-exists=.env scripts/add-staff.js",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
