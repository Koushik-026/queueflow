PORT=3100
HOST=127.0.0.1
DATABASE_PATH=./data/queueflow.sqlite
ALLOW_DEMO=true
SHOWCASE_ONLY=false
TRUST_PROXY=0
# For a hosted service set HOST=0.0.0.0 and a private JWT_SECRET of at least 32 characters.
# Set DATABASE_PATH to a path on persistent storage to retain records across deployments.
# The local installation generates and saves a private signing key when JWT_SECRET is omitted.
# A free showcase deployment uses SHOWCASE_ONLY=true and TRUST_PROXY=1 behind Render's proxy.
